# Uploaded photos only - nothing in here may ever run as a script
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar

<FilesMatch "(?i)\.(php\d*|phtml|phar|pl|py|cgi|sh|shtml|html?|svg|js)$">
    Deny from all
</FilesMatch>
